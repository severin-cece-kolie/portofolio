# Example environment variables (do NOT commit .env)
# For EmailJS (if you keep using EmailJS) — public key can be client-side,
# but service/template IDs should be configured in a server environment.
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
CONTACT_EMAIL=your.email@example.com
EMAILJS_USER_ID=YOUR_EMAILJS_USER_ID

# Example: other service secrets
#SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
#SMTP_USER=your_smtp_user
#SMTP_PASS=your_smtp_password
